    {
      "parameters": {
        "jsCode": "const text = String($input.first().json.output || '').trim() || 'I could not generate a reply.';\nconst max = 3800;\nconst parts = [];\nlet rest = text;\nwhile (rest.length > max) {\n  let cut = rest.lastIndexOf('\\n', max);\n  if (cut < max / 2) cut = rest.lastIndexOf(' ', max);\n  if (cut < max / 2) cut = max;\n  parts.push(rest.slice(0, cut));\n  rest = rest.slice(cut).trimStart();\n}\nparts.push(rest);\nreturn parts.map(output => ({ json: { output } }));"
      },
      "id": "f75e3b8b-c5fb-49fd-b0c8-822ab9a2c44c",
